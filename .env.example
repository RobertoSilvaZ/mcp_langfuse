# Langfuse URL reachable from within Docker (change port to match your deployment)
LANGFUSE_HOST=http://host.docker.internal:8099
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
# v1 for self-hosted Langfuse v3; v2 for v4+
LANGFUSE_API_VERSION=v1

# Ngrok: reserved domain only, without https:// or /mcp
NGROK_DOMAIN=resolutive-keegan-humbler.ngrok-free.dev
NGROK_AUTHTOKEN=replace-with-ngrok-authtoken

# Absolute local folder to mount read-only; set to the project you want to inspect.
# On Windows use forward slashes. Do not point to your whole home directory.
SOURCE_CODE_PATH=D:/your-project/source
