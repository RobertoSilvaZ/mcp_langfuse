# URL reachable from inside the MCP container. If Langfuse publishes port 3000 on the Docker host:
LANGFUSE_HOST=http://host.docker.internal:3000
# To use a shared Docker network, use http://langfuse-web:3000 instead.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
# v2: Langfuse v4+; v1: self-hosted Langfuse v3
LANGFUSE_API_VERSION=v2
